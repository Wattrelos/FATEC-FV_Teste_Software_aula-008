{
    "name": "fatec-fv/lab-login-exaustivo",
    "description": "Laboratório de Teste Exaustivo de Login e Segurança - FATEC Ferraz de Vasconcelos",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "backend/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Josias Sobrinho",
            "email": "josiaswattrelos-ciee@yahoo.com.br"
        }
    ],
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2",
        "vimeo/psalm": "^6.19",
        "rector/rector": "^2.6",
        "pestphp/pest": "^3.8",
        "mockery/mockery": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "squizlabs/php_codesniffer": "^3.13",
        "nunomaduro/phpinsights": "^2.14"
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest tests/Unit",
        "test:integration": "pest tests/Integration",
        "test:phpunit": "phpunit --testdox",
        "stan": "phpstan analyse",
        "phpstan": "phpstan analyse",
        "cs-check": "phpcs --standard=PSR12 -n backend/src tests",
        "cs-fix": "php-cs-fixer fix",
        "fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "insights": "phpinsights analyse backend/src --no-interaction",
        "self-healing": [
            "@cs-fix",
            "@stan",
            "@test"
        ],
        "start": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
