{
    "name": "fatec-fv/lab-login-exaustivo",
    "description": "Laboratório de Teste Exaustivo de Login e Segurança - FATEC Ferraz de Vasconcelos",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "backend/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Josias Sobrinho",
            "email": "josiaswattrelos-ciee@yahoo.com.br"
        }
    ],
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit tests/Unit",
        "test:integration": "phpunit tests/Integration",
        "start": "php -S 127.0.0.1:8080 -t public"
    }
}
