@startuml "Sistema de Autenticação e Segurança - Diagrama de Arquitetura (Aula-08)"

' ==============================================================================
' 🎨 PLANTUML CSS & SKINPARAM STYLING ENGINE
' ==============================================================================
skinparam backgroundColor #FEFEFE
<style>
  root {
    backgroundColor #FEFEFE
    FontName "Inter", "Segoe UI", "Helvetica Neue", sans-serif
    FontSize 11
    FontColor #0F172A
  }
  document {
    backgroundColor #FEFEFE
  }
  package {
    RoundCorner 10
    LineThickness 1.5
    FontSize 12
    FontStyle bold
  }
  component {
    RoundCorner 8
    LineThickness 1.2
    FontSize 11
    backgroundColor #FEFEFE
  }
  interface {
    LineThickness 1.5
    FontSize 11
  }
  arrow {
    LineThickness 1.3
    FontSize 10
  }
  note {
    RoundCorner 10
    LineThickness 1.2
    FontSize 11
    BackgroundColor #FEFCE8
    LineColor #EAB308
    FontColor #713F12
  }
  legend {
    RoundCorner 10
    LineThickness 1.2
    FontSize 10
    BackgroundColor #F8FAFC
    LineColor #CBD5E1
    FontColor #0F172A
  }
</style>

skinparam defaultFontName "Inter", "Segoe UI", "Helvetica Neue", sans-serif
skinparam shadowing false
skinparam roundCorner 8
hide stereotype

' --- 0. CLIENT / FRONTEND & DELIVERY (Índigo) ---
skinparam package<<delivery>> {
  BackgroundColor #EEF2FF
  BorderColor #6366F1
  FontColor #312E81
}
skinparam component<<deliveryComp>> {
  backgroundColor #FEFEFE
  BorderColor #818CF8
  FontColor #1E1B4B
}

' --- 1. MIDDLEWARES (Âmbar/Dourado) ---
skinparam package<<middleware>> {
  BackgroundColor #FFFBEB
  BorderColor #F59E0B
  FontColor #78350F
}
skinparam component<<middlewareComp>> {
  backgroundColor #FEFEFE
  BorderColor #FBBF24
  FontColor #451A03
}

' --- 2. PRESENTATION / HTTP CONTROLLERS (Rosa/Magenta) ---
skinparam package<<presentation>> {
  BackgroundColor #FDF2F8
  BorderColor #EC4899
  FontColor #831843
}
skinparam package<<presentationSub>> {
  BackgroundColor #FFF1F2
  BorderColor #FB7185
  FontColor #9F1239
}
skinparam component<<presentationComp>> {
  backgroundColor #FEFEFE
  BorderColor #F472B6
  FontColor #831843
}

' --- 3. APPLICATION (Azul Oceano) ---
skinparam package<<application>> {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  FontColor #1E3A8A
}
skinparam component<<applicationComp>> {
  backgroundColor #FEFEFE
  BorderColor #60A5FA
  FontColor #1E3A8A
}

' --- 4. DOMAIN (Verde Esmeralda - Pure Core) ---
skinparam package<<domain>> {
  BackgroundColor #ECFDF5
  BorderColor #10B981
  FontColor #064E3B
}
skinparam package<<domainSub>> {
  BackgroundColor #F0FDF4
  BorderColor #34D399
  FontColor #065F46
}
skinparam component<<domainComp>> {
  backgroundColor #FEFEFE
  BorderColor #10B981
  FontColor #064E3B
}
skinparam interface<<domainContract>> {
  backgroundColor #FEFEFE
  BorderColor #059669
  FontColor #065F46
}

' --- 5. INFRASTRUCTURE (Roxo / Violeta) ---
skinparam package<<infra>> {
  BackgroundColor #FAF5FF
  BorderColor #8B5CF6
  FontColor #4C1D95
}
skinparam component<<infraComp>> {
  backgroundColor #FEFEFE
  BorderColor #A78BFA
  FontColor #4C1D95
}

' ==============================================================================
' 0. CLIENTS, FRONT CONTROLLER & BOOTSTRAP
' ==============================================================================
package "0. 🌐 Clients & HTTP Delivery (Front Controller & Slim PSR-7/15)" as DeliveryLayer <<delivery>> {
    [<b>Single Page Interfaces (HTML/JS)</b>\n<size:10><i>login.html / dashboard.html / resultado.html</i></size>] as FrontendViews <<deliveryComp>>
    [<b>public/index.php</b>\n<size:10><i>Ponto Único de Entrada (Front Controller)</i></size>] as Entrypoint <<deliveryComp>>
    [<b>AppBootstrap & routes.php</b>\n<size:10><i>(Roteamento Slim Framework 4)</i></size>] as RouteDefinitions <<deliveryComp>>
    [<b>PHP-DI Container</b>\n<size:10><i>(Injeção de Dependências PSR-11 / dependencies.php)</i></size>] as Container <<deliveryComp>>
}

' ==============================================================================
' 1. MIDDLEWARE PIPELINE
' ==============================================================================
package "1. 🛡️ Pipeline de Segurança & Middlewares (PSR-15)" as MiddlewareLayer <<middleware>> {
    [<b>SecurityHeadersMiddleware</b>\n<size:10><i>Cabeçalhos OWASP (CSP, HSTS, X-Frame-Options)</i></size>] as SecHeadersMW <<middlewareComp>>
    [<b>CsrfMiddleware</b>\n<size:10><i>Validação de Token Anti-CSRF via Header/Body</i></size>] as CsrfMW <<middlewareComp>>
    [<b>RateLimitMiddleware</b>\n<size:10><i>Mitigação de Brute Force (5 tentativas / 60s)</i></size>] as RateMW <<middlewareComp>>
    [<b>CustomerAuthMiddleware</b>\n<size:10><i>Guarda de Rotas Privadas (Sessão Ativa /api/dashboard)</i></size>] as AuthMW <<middlewareComp>>
}

' ==============================================================================
' 2. PRESENTATION LAYER (ADR - Action Controllers & Responders)
' ==============================================================================
package "2. 🎯 Camada de Apresentação HTTP (Padrão ADR)" as PresentationLayer <<presentation>> {
    package "Action Controllers (Single Responsibility)" as ActionControllers <<presentationSub>> {
        [<b>CsrfTokenAction</b>\n<size:10><i>GET /api/csrf-token (Geração e sincronização)</i></size>] as CsrfAction <<presentationComp>>
        [<b>LoginAction</b>\n<size:10><i>POST /login & POST /api/login</i></size>] as LoginAction <<presentationComp>>
        [<b>LogoutAction</b>\n<size:10><i>POST /api/logout & GET /logout</i></size>] as LogoutAction <<presentationComp>>
        [<b>DashboardAction</b>\n<size:10><i>GET /api/dashboard & GET /api/me</i></size>] as DashAction <<presentationComp>>
    }

    package "Responders HTTP" as Responders <<presentationSub>> {
        [<b>JsonResponder</b>\n<size:10><i>Respostas padronizadas JSON (PSR-7)</i></size>] as JsonResponder <<presentationComp>>
    }
}

' ==============================================================================
' 3. APPLICATION LAYER (Use Cases & DTOs)
' ==============================================================================
package "3. ⚙️ Camada de Aplicação (Casos de Uso & DTOs)" as ApplicationLayer <<application>> {
    [<b>LoginInputDTO & LoginOutputDTO</b>\n<size:10><i>Contratos de entrada/saída tipados e imutáveis</i></size>] as AppDTOs <<applicationComp>>
    [<b>AuthenticateCustomerUseCase</b>\n<size:10><i>Orquestra validação de credenciais, status e auditoria</i></size>] as AuthUseCase <<applicationComp>>
}

' ==============================================================================
' 4. DOMAIN LAYER (Pure Business Logic)
' ==============================================================================
package "4. 💎 Camada de Domínio (Regras de Negócio Puras)" as DomainLayer <<domain>> {
    [<b>Customer Entity</b>\n<size:10><i>ID, Nome, Email, Senha, Status (Ativo/Inativo)</i></size>] as CustomerEntity <<domainComp>>
    
    package "Value Objects (Imutáveis)" as DomainVOs <<domainSub>> {
        [<b>Email</b>\n<size:10><i>Validação estrita RFC e formatação</i></size>] as EmailVO <<domainComp>>
        [<b>PasswordHash</b>\n<size:10><i>Verificação segura (password_verify)</i></size>] as PasswordHashVO <<domainComp>>
    }

    package "Contratos de Repositório (Portas / DIP)" as DomainContracts <<domainSub>> {
        interface "CustomerRepositoryInterface" as CustomerRepoInterface <<domainContract>>
    }
}

' ==============================================================================
' 5. INFRASTRUCTURE & PERSISTENCE
' ==============================================================================
package "5. 🔌 Camada de Infraestrutura (Adaptadores Técnicos)" as InfraLayer <<infra>> {
    [<b>InMemoryCustomerRepository</b>\n<size:10><i>Implementação em memória com dados pré-populados</i></size>] as InMemoryRepo <<infraComp>>
    [<b>SessionConfig</b>\n<size:10><i>Cookies HttpOnly, SameSite=Strict, session_regenerate_id</i></size>] as SessionInfra <<infraComp>>
    [<b>SecurityLogger</b>\n<size:10><i>Auditoria de acessos e mascaramento de dados sensíveis</i></size>] as LoggerInfra <<infraComp>>
}

' ==============================================================================
' NOTAS DIDÁTICAS DE ARQUITETURA
' ==============================================================================
note right of PresentationLayer
  <b>🎯 Padrão ADR (Action-Domain-Responder)</b>
  <b>1. Action:</b> Recebe Request PSR-7, extrai credenciais e aciona o Caso de Uso.
  <b>2. Domain/Application:</b> Executa regras de negócio de forma isolada.
  <b>3. Responder:</b> Formata resposta JSON uniforme via JsonResponder.
end note

note left of DomainLayer
  <b>💎 Clean Architecture & Inversão de Dependência (DIP)</b>
  O <b>Domínio</b> não conhece HTTP, Frameworks ou Banco.
  A <b>Infraestrutura</b> implementa a interface
  <i>CustomerRepositoryInterface</i> sem acoplar o Core.
end note

note right of MiddlewareLayer
  <b>🛡️ Defesa em Camadas (OWASP)</b>
  • <b>SecurityHeaders:</b> Protege contra XSS, Clickjacking e Sniffing.
  • <b>Csrf:</b> Evita requisições forjadas entre sites.
  • <b>RateLimit:</b> Bloqueia ataques de força bruta / credenciais spray.
  • <b>CustomerAuth:</b> Impede acesso sem sessão autenticada válida.
end note

' ==============================================================================
' HIERARQUIA VERTICAL DAS CAMADAS
' ==============================================================================
DeliveryLayer -[hidden]down-> MiddlewareLayer
MiddlewareLayer -[hidden]down-> PresentationLayer
PresentationLayer -[hidden]down-> ApplicationLayer
ApplicationLayer -[hidden]down-> DomainLayer
DomainLayer -[hidden]down-> InfraLayer

' ==============================================================================
' RELACIONAMENTOS E FLUXO DE EXECUÇÃO
' ==============================================================================

' --- 1. REQUISIÇÃO E DISPATCH ---
FrontendViews -[#2563EB,bold]-> Entrypoint : 1. Requisição HTTP (Fetch/Form)
Entrypoint -[#2563EB,bold]-> RouteDefinitions : 2. Despacha para Slim App
Entrypoint ..[#7C3AED,dashed]> Container : 3. Inicializa Container PHP-DI

' --- 2. PIPELINE DE MIDDLEWARES ---
RouteDefinitions -[#2563EB,bold]-> SecHeadersMW : Pipeline Global (Adiciona Headers)
SecHeadersMW -[#2563EB]-> CsrfMW : Valida Token Anti-CSRF
CsrfMW -[#2563EB]-> RateMW : Avalia contagem de tentativas por IP
RateMW -[#2563EB]-> LoginAction : Encaminha requisição validada

' --- 3. INJEÇÃO DE DEPENDÊNCIAS ---
Container ..[#7C3AED,dashed]> LoginAction : Injeta AuthenticateCustomerUseCase & SecurityLogger
Container ..[#7C3AED,dashed]> AuthUseCase : Injeta CustomerRepositoryInterface
Container ..[#7C3AED,dashed]> InMemoryRepo : Registra Singleton do Repositório

' --- 4. CAMADA DE APRESENTAÇÃO PARA APLICAÇÃO ---
LoginAction -[#2563EB]-> AppDTOs : Monta LoginInputDTO (email, senha)
LoginAction -[#2563EB,bold]-> AuthUseCase : Executa execute(LoginInputDTO)
LoginAction -[#0284C7]-> SessionInfra : Regenera ID de sessão em caso de sucesso
LoginAction -[#7C3AED]-> LoggerInfra : Registra login_success / login_failed
LoginAction -[#2563EB]-> JsonResponder : Converte LoginOutputDTO em resposta JSON PSR-7
JsonResponder -[#2563EB]-> FrontendViews : Retorna JSON {success, message, user}

' --- 5. CASO DE USO E DOMÍNIO ---
AuthUseCase -[#2563EB]-> EmailVO : Instancia e valida e-mail informado
AuthUseCase -[#2563EB]-> CustomerRepoInterface : Consulta findByEmail(email)
AuthUseCase -[#2563EB]-> CustomerEntity : Verifica status da conta (isAtivo())
AuthUseCase -[#2563EB]-> PasswordHashVO : Valida hash da senha (verify())
AuthUseCase -[#2563EB]-> AppDTOs : Retorna LoginOutputDTO para o Controller

' --- 6. FLUXO PROTEGIDO (DASHBOARD & LOGOUT) ---
FrontendViews -[#2563EB]-> AuthMW : GET /api/dashboard
AuthMW -[#0284C7]-> SessionInfra : Valida flag de sessão ativa ($_SESSION['user'])
AuthMW -[#2563EB]-> DashAction : Libera requisição autenticada
LogoutAction -[#0284C7]-> SessionInfra : Destrói sessão e cookies de autenticação

' --- 7. INVERSÃO DE DEPENDÊNCIA (DIP) ---
CustomerRepoInterface <|.[#059669,bold]. InMemoryRepo : <b><color:#059669>[DIP]</color></b> Implementa Contrato

' ==============================================================================
' LEGENDA DIDÁTICA DO DIAGRAMA
' ==============================================================================
legend right
  | <size:12><b>CAMADA ARQUITETURAL</b></size> | <size:12><b>COMPONENTES PRESENTES NO PROJETO</b></size> |
  | <back:#EEF2FF><color:#312E81><b> 0. Entrega & Frontend </b></color></back> | Telas HTML/JS (public/), Front Controller (index.php), Container PHP-DI |
  | <back:#FFFBEB><color:#78350F><b> 1. Middlewares PSR-15 </b></color></back> | SecurityHeaders, CsrfMiddleware, RateLimitMiddleware, CustomerAuth |
  | <back:#FDF2F8><color:#831843><b> 2. Apresentação (ADR) </b></color></back> | LoginAction, LogoutAction, CsrfTokenAction, DashboardAction, JsonResponder |
  | <back:#EFF6FF><color:#1E3A8A><b> 3. Aplicação </b></color></back> | AuthenticateCustomerUseCase, LoginInputDTO, LoginOutputDTO |
  | <back:#ECFDF5><color:#064E3B><b> 4. Domínio Puro </b></color></back> | Customer Entity, Email VO, PasswordHash VO, CustomerRepositoryInterface |
  | <back:#FAF5FF><color:#4C1D95><b> 5. Infraestrutura </b></color></back> | InMemoryCustomerRepository, SessionConfig, SecurityLogger |
  | <size:12><b>TIPO DE CONEXÃO</b></size> | <size:12><b>SIGNIFICADO</b></size> |
  | <color:#2563EB><b>────────></b></color> (Azul Sólido) | **Fluxo Direto / Chamada Síncrona** (Requisições HTTP, Execução de Casos de Uso) |
  | <color:#059669><b>- - - - - ▷</b></color> (Verde Tracejado) | **Inversão de Dependência [DIP]** (Implementação concreta de contratos do Domínio) |
  | <color:#7C3AED><b>· · · · · ></b></color> (Roxo Pontilhado) | **Injeção de Dependências [DI]** (Resolução via Container PSR-11) |
  | <color:#0284C7><b>────────></b></color> (Azul Petróleo) | **Manipulação de Sessão / Estado** (Regeneração, cookies, validação) |
endlegend

@enduml